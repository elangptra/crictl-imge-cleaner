[Unit]
Description=Crictl Unused Image Cleanup
Wants=network-online.target
After=network-online.target containerd.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/crictl-image-cleanup/scripts/image-cleanup.py /etc/image-cleanup/config.yaml
NoNewPrivileges=true
PrivateTmp=true
